{
  "manifest_version": 3,
  "name": "OPT Employer Checker",
  "version": "1.0.1",
  "description": "Shows E-Verify and H-1B facts next to employers on LinkedIn job pages. Unofficial; not legal advice.",
  "permissions": [],
  "host_permissions": [
    "https://markplowwright.github.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/reader.js",
        "content/view.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OPT Employer Checker: open the data site",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
